rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.enabled == true;
      allow write: if false;
    }

    match /payment_methods/{paymentMethodId} {
      allow read: if signedIn() && resource.data.enabled == true;
      allow write: if false;
    }

    match /settings/recharge {
      allow read: if signedIn();
      allow write: if false;
    }

    match /wallets/{userUid} {
      allow read: if signedIn() && request.auth.uid == userUid;
      allow write: if false;
    }

    match /recharge_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.processedAt == null
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.reference is string
        && request.resource.data.reference.size() > 0;
      allow read: if signedIn() && resource.data.userUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /subscription_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.processedAt == null
        && request.resource.data.amount is int
        && request.resource.data.amount > 0;
      allow read: if signedIn() && resource.data.userUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
